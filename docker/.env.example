# Template for $HOME/.eureka_env on Nibi.
#
# Copy this to ~/.eureka_env on the cluster and fill in your keys:
#   cp .env.example ~/.eureka_env
#   chmod 600 ~/.eureka_env
#   $EDITOR ~/.eureka_env
#
# job.sh sources this file before `apptainer exec` so the keys are present
# in the shell env, then passes them through with `--env GOOGLE_API_KEY` etc.
# (no `=value` syntax — that would silently inject blanks if unset).
#
# DO NOT commit a filled-in copy of this file. It is fine to commit this
# template (no secrets in it).

# Required: Google Gemini API key for VLM preference comparisons.
# Get one at https://aistudio.google.com/apikey
export GOOGLE_API_KEY=

# Required (unless you pass --no_wandb to the pipeline): Weights & Biases key.
# Get yours at https://wandb.ai/authorize
export WANDB_API_KEY=

# Optional: override the default wandb entity if you're posting runs to a
# different team. Defaults to george-xue-university-of-toronto in
# reward_learning_pipeline.py.
# export WANDB_ENTITY=
